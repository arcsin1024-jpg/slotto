# apps/web/.env.local にコピーして使う。値は `supabase status` で確認できる

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase(ローカルは http://127.0.0.1:54421)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用(secret key)
SUPABASE_SECRET_KEY=

# 32 バイトを base64 にした値。作り方(PowerShell):
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
TOKEN_ENCRYPTION_KEY=
# 内部 API(/api/internal/*)の共有シークレット
CRON_SECRET=

# 以下は用意できたら設定する(未設定でも開発はできる)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Slotto <no-reply@example.com>
AI_GATEWAY_API_KEY=
EXPO_ACCESS_TOKEN=
