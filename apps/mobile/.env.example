# apps/mobile/.env にコピーして使う(.env はコミットしない)
# PC のローカル Supabase に届くアドレスを書く
#   Android エミュレータ: http://10.0.2.2:54421
#   実機(Expo Go など): PC の LAN の IP(例 http://192.168.x.x:54421)。127.0.0.1 は端末自身を指すので使えない
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54421
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web の URL。API(予約の操作、接続先の登録など)と、予約ページの共有リンクに使う
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
